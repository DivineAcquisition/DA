# Supabase — shared by every Vistrial surface.
# The publishable key is safe in a browser bundle. The secret key must never be.
NEXT_PUBLIC_SUPABASE_URL=https://onobzewvjsicwxbsdlzw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_D0zVxSKE4J38HvaFJtWGqw_HmDl0AF5

# Strict host-based routing. Each host only serves its surface (404 otherwise).
# Comma-separated. Localhost and *.vercel.app keep path-based access for previews.
VISTRIAL_CONTROL_HOSTS=ad.vistrial.io
VISTRIAL_ADMIN_HOSTS=da.vistrial.io
VISTRIAL_ACCT_HOSTS=acct.vistrial.io
VISTRIAL_OPS_HOSTS=ops.vistrial.io,ops.divineacquisition.io,vistrial.divineacquisition.io
VISTRIAL_CAREERS_HOSTS=vistrial.io,www.vistrial.io,divineacquisition.io,www.divineacquisition.io

# Google Drive. Evidence files live in Drive; Vistrial stores only references.
# A service account with domain-wide delegation, or an OAuth refresh token.
# Without these the vault still records metadata but cannot create folders,
# upload, or mint time-limited share links.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# The Drive folder new client folders are created inside.
GOOGLE_DRIVE_PARENT_FOLDER_ID=
# Optional: impersonate a user when using domain-wide delegation.
GOOGLE_DRIVE_SUBJECT_EMAIL=
