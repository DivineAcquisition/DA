# Supabase — shared by every Vistrial surface. Both are required: without them
# every surface renders the "not connected" screen rather than quietly falling
# back to some other project.
# The publishable key is safe in a browser bundle. The secret key must never be.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer the publishable key. The older anon key name is still accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Strict host-based routing. Each host only serves its surface (404 otherwise).
# Comma-separated. Localhost and *.vercel.app keep path-based access for previews.
VISTRIAL_CONTROL_HOSTS=ad.vistrial.io
VISTRIAL_ADMIN_HOSTS=da.vistrial.io
VISTRIAL_ACCT_HOSTS=acct.vistrial.io
VISTRIAL_OPS_HOSTS=ops.vistrial.io,ops.divineacquisition.io,vistrial.divineacquisition.io
VISTRIAL_CAREERS_HOSTS=vistrial.io,www.vistrial.io,divineacquisition.io,www.divineacquisition.io
VISTRIAL_TALENT_HOSTS=talent.divineacquisition.io
VISTRIAL_ASSESSMENT_ADMIN_HOSTS=admin.divineacquisition.io

# Public URLs used when composing assessment booking emails.
NEXT_PUBLIC_TALENT_HOST=https://talent.divineacquisition.io
NEXT_PUBLIC_ASSESSMENT_ADMIN_HOST=https://admin.divineacquisition.io

# Resend — assessment invite emails from admin.divineacquisition.io
RESEND_API_KEY=
RESEND_FROM=Divine Acquisition Talent <noreply@noreply.divineacquisition.io>
# Optional reply-to for assessment invites
RESEND_REPLY_TO=
# CC on every assessment invite (comma-separated). Defaults to malik@divineacquisition.io
RESEND_CC=malik@divineacquisition.io

# GoHighLevel Private Integration Token (talent acquisition subaccount)
GHL_PIT_TOKEN=
# Assessment Interview calendar (defaults match the talent booking widget)
GHL_LOCATION_ID=pNbNaLXpftikGN2jOFKG
GHL_CALENDAR_ID=3rTT9rZW2jG4lhZBae3D

# Cron auth for /api/cron/* (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Service role key — required for assessment reminder claims (never expose publicly)
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive. Evidence files live in Drive; Vistrial stores only references.
# A service account with domain-wide delegation, or an OAuth refresh token.
# Without these the vault still records metadata but cannot create folders,
# upload, or mint time-limited share links.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# The Drive folder new client folders are created inside.
GOOGLE_DRIVE_PARENT_FOLDER_ID=
# Optional: impersonate a user when using domain-wide delegation.
GOOGLE_DRIVE_SUBJECT_EMAIL=

# Google Calendar / Meet for admin-scheduled assessment calls.
# Falls back to GOOGLE_DRIVE_* credentials when unset. Subject email is required
# (domain-wide delegation) so Meet links can be created on a real calendar.
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_SUBJECT_EMAIL=
GOOGLE_CALENDAR_ID=primary
