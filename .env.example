# Supabase — shared by every Vistrial surface. Both are required: without them
# every surface renders the "not connected" screen rather than quietly falling
# back to some other project.
# The publishable key is safe in a browser bundle. The secret key must never be.
# DivineACQ (hfgattcqlzuyahqywuoq) — https://hfgattcqlzuyahqywuoq.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://hfgattcqlzuyahqywuoq.supabase.co
# Prefer the publishable key. The older anon key name is still accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Strict host-based routing. Each host only serves its surface (404 otherwise).
# Comma-separated. Localhost and *.vercel.app keep path-based access for previews.
# Cutover: defaults are divineacquisition.io. Drop any remaining *.vistrial.io hosts
# from production env once DNS points at the new names.
#
# admin.divineacquisition.io is the unified admin portal (agreements + growth +
# control + assessment + ops). Dedicated hosts below remain as cutover aliases.
VISTRIAL_CONTROL_HOSTS=ad.divineacquisition.io
VISTRIAL_ADMIN_HOSTS=da.divineacquisition.io
VISTRIAL_ACCT_HOSTS=acct.divineacquisition.io
VISTRIAL_OPS_HOSTS=ops.divineacquisition.io,vistrial.divineacquisition.io
VISTRIAL_CAREERS_HOSTS=divineacquisition.io,www.divineacquisition.io
VISTRIAL_TALENT_HOSTS=talent.divineacquisition.io
# Assessment admin lives under the unified portal. Give it a host only if needed.
VISTRIAL_ASSESSMENT_ADMIN_HOSTS=
# Unified admin portal: /workspace, /da, /ad, /admin, /vistrial
DA_WORKSPACE_HOSTS=admin.divineacquisition.io
VISTRIAL_ACQ_HOSTS=acq.divineacquisition.io

# Public URLs used when composing assessment booking emails.
NEXT_PUBLIC_TALENT_HOST=https://talent.divineacquisition.io
# Assessment booking admin is merged into /workspace/calendar-links on this host.
NEXT_PUBLIC_ASSESSMENT_ADMIN_HOST=https://admin.divineacquisition.io
# Public base for tokenized page/calendar URLs (also configurable in Settings)
NEXT_PUBLIC_DA_WORKSPACE_HOST=https://admin.divineacquisition.io

# DocuSeal. The key set in Settings wins; this is the fallback so the pull works
# before anyone signs in. Used to pull templates, agreements and submitted field
# values, and to pre-fill forms before signing.
DOCUSEAL_API_KEY=

# Acquisition founding-install landing (acq.divineacquisition.io → /acq)
NEXT_PUBLIC_ACQ_HOST=https://acq.divineacquisition.io
# Hero Wistia media id (defaults to topebzrych)
NEXT_PUBLIC_ACQ_WISTIA_ID=topebzrych
# Meta Pixel. PageView on load, ViewContent on VSL play, Lead after form success.
NEXT_PUBLIC_META_PIXEL_ID=2779578425739507
# Must match the event Ads Manager optimizes toward.
NEXT_PUBLIC_ACQ_PIXEL_LEAD_EVENT=Lead
# GHL inbound webhook or form endpoint — optional side channel after Step 1.
ACQ_GHL_WEBHOOK_URL=
# Optional: post through the GHL forms API in addition to the contacts API.
ACQ_GHL_FORM_ID=
# Client-acquisition GHL location. Required for /api/submit-lead. Do not reuse the talent location.
ACQ_GHL_LOCATION_ID=
# Optional GHL custom-field ids if the location does not use the DA - * names.
# GHL_FIELD_AD_SPEND=
# GHL_FIELD_FOLLOW_UP=
# GHL_FIELD_PROGRAM_PRICE=
# GHL_FIELD_READINESS=
# GHL_FIELD_QUAL_RESULT=
# Founding-install booking calendar. Defaults to the issued msgsndr widget.
NEXT_PUBLIC_ACQ_CALENDAR_EMBED_URL=https://link.msgsndr.divineacquisition.io/widget/booking/v0e24e3kxYEGCTUkSP4A
# NEXT_PUBLIC_ACQ_CALENDAR_WIDGET_ID=
# Airtable DA Pipeline — ClientAcquisition Leads table (defaults match the live base).
# Used to write landing-page leads and to search Qualified prospects for internal booking.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=apprsfnMvzEAfsg39
AIRTABLE_LEADS_TABLE_ID=tblDgFYwsGzoDqzF1
# Entry Point select. Add a "Landing Page" choice in Airtable to use that value.
# AIRTABLE_ENTRY_POINT=Landing Page
# Optional Slack/webhook for Step 2/3 scoring failures. Step 1 failures still block the user.
# ACQ_ERROR_WEBHOOK=
# PIT for GHL contacts. GHL_PIT_KEY is accepted as an alias.
# GHL_PIT_KEY=

# Resend — Divine Acquisition branded emails (assessment + agreement invites)
RESEND_API_KEY=
RESEND_FROM=Divine Acquisition Talent <noreply@noreply.divineacquisition.io>
# Optional override for agreement signing invites (defaults to RESEND_FROM)
# RESEND_AGREEMENT_FROM=Divine Acquisition <noreply@noreply.divineacquisition.io>
# Optional reply-to for assessment invites
RESEND_REPLY_TO=
# Optional reply-to for agreement invites (defaults to RESEND_REPLY_TO)
# RESEND_AGREEMENT_REPLY_TO=malik@divineacquisition.io
# CC on every assessment invite (comma-separated). Defaults to malik@divineacquisition.io
RESEND_CC=malik@divineacquisition.io

# GoHighLevel Private Integration Token (talent acquisition subaccount)
GHL_PIT_TOKEN=
# Assessment Interview calendar (defaults match the talent booking widget)
GHL_LOCATION_ID=pNbNaLXpftikGN2jOFKG
GHL_CALENDAR_ID=3rTT9rZW2jG4lhZBae3D

# Cron auth for /api/cron/* (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Service role key — required for assessment reminder claims (never expose publicly)
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive. Evidence files live in Drive; Vistrial stores only references.
# A service account with domain-wide delegation, or an OAuth refresh token.
# Without these the vault still records metadata but cannot create folders,
# upload, or mint time-limited share links.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# The Drive folder new client folders are created inside.
GOOGLE_DRIVE_PARENT_FOLDER_ID=
# Optional: impersonate a user when using domain-wide delegation.
GOOGLE_DRIVE_SUBJECT_EMAIL=

# Google Calendar / Meet for admin-scheduled assessment calls.
# Falls back to GOOGLE_DRIVE_* credentials when unset. Subject email is required
# (domain-wide delegation) so Meet links can be created on a real calendar.
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_SUBJECT_EMAIL=
GOOGLE_CALENDAR_ID=primary
